# ===================================================================
# Liver Cirrhosis Prediction System - Environment Configuration
# ===================================================================

# Application Server Settings
PORT=8080
HOST=127.0.0.1
FLASK_DEBUG=0

# MySQL Database Settings (Temporary credentials - change to your MySQL user/password)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Babi@143
MYSQL_DATABASE=liver_cirrhosis_db

# Database Engine Selection:
# 'mysql'  : Connects to MySQL (with auto-fallback to SQLite if MySQL service is stopped)
# 'sqlite' : Forces local SQLite database in backend/instance/predictions.db
DB_ENGINE=mysql
